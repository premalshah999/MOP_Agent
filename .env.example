APP_VERSION=0.1.0
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRY_SECONDS=86400
SQLITE_DB_PATH=data/runtime/mop.sqlite3
DUCKDB_PATH=data/runtime/mop.duckdb
MAX_RETURN_ROWS=250
QUERY_TIMEOUT_SECONDS=15
DEBUG_ERRORS=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
TRUSTED_HOSTS=127.0.0.1,localhost,testserver

# Comma-separated emails granted access to /admin and /api/admin/* endpoints.
# Leave empty in dev to disable admin entirely.
ADMIN_EMAILS=you@university.edu

# Optional: Sentry error tracking (https://sentry.io free tier is plenty for a
# 40-50 user demo). Leave empty in dev — when unset the SDK is never loaded.
SENTRY_DSN=
# SENTRY_TRACES_RATE=0.05   # share of requests traced for perf; default 5%

# Optional: External uptime monitoring (no code change). After deploy, register
# the /health URL with https://uptimerobot.com (free 50 monitors @ 5-min ping).

# REQUIRED. Select exactly one live provider. `auto` preserves legacy precedence
# (DeepSeek, then Gemini, then OpenAI), but an explicit value is safer when
# multiple keys exist.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Start provider migrations in non-thinking mode so temperature=0 remains
# effective and latency/cost stay comparable. Enable thinking only after the
# complete live gate passes; tool turns preserve DeepSeek reasoning_content.
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MIN_COMPLETION_TOKENS=4096
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Flash-Lite is most reliable here with minimal thinking and a compact output
# budget; short attempts plus retries recover transient provider stalls.
GEMINI_REASONING_EFFORT=minimal
GEMINI_MIN_COMPLETION_TOKENS=512
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional explicit-provider overrides. Normally leave these empty and use the
# provider-specific variables above. The legacy ASSISTANT_ROUTER_* variables
# are honored only in `auto` mode.
# LLM_BASE_URL=
# LLM_MODEL=

# LLM client tuning (optional):
LLM_TIMEOUT=12
LLM_RETRIES=2
# Must remain below docker-compose.yml's stop_grace_period so active streams
# can finish cleanly during a deployment.
GRACEFUL_SHUTDOWN_TIMEOUT=135
# LLM_MODE=fixture  -> force recorded-fixture replay (offline tests)
# LLM_RECORD=1      -> when live, save responses as fixtures for offline CI
