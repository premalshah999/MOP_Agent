APP_VERSION=production
APP_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_SECONDS=86400

MOP_AGENT_PORT=8000
MAX_RETURN_ROWS=250
QUERY_TIMEOUT_SECONDS=15
DEBUG_ERRORS=false

# Uvicorn worker processes. Default 4 is sized for 40-50 concurrent users
# (LLM calls are I/O-bound — workers protect against one long reasoning
# query blocking everyone). Bump higher if reasoning-mode usage climbs.
WEB_CONCURRENCY=4
# Allow in-flight streamed answers to drain on deploy (Docker waits 150s).
GRACEFUL_SHUTDOWN_TIMEOUT=135

# In-process JSONL log rotation
LOG_ROTATE_MAX_BYTES=10485760   # 10MB per file
LOG_ROTATE_KEEP=5               # retain N FIFO archives

ALLOWED_ORIGINS=https://your-domain.example
TRUSTED_HOSTS=your-domain.example,localhost,127.0.0.1

# Comma-separated emails with admin (/admin dashboard + /api/admin/*) access.
# Leave empty to disable admin in prod.
ADMIN_EMAILS=admin@your-domain.example

# Optional: Sentry error tracking. Sign up at https://sentry.io (free tier)
# and paste the DSN here. Leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_RATE=0.05

# External uptime monitoring (no code change required): after deploy,
# register http://<host>/health at https://uptimerobot.com with a 5-min
# interval — gives email/Slack alerts when the box goes down.

# REQUIRED in production. Select the provider explicitly so leaving an old key
# in the file cannot silently route traffic to the wrong vendor.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MIN_COMPLETION_TOKENS=4096
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_EFFORT=minimal
GEMINI_MIN_COMPLETION_TOKENS=512
LLM_TIMEOUT=12
LLM_RETRIES=2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === Gemini cutover ===
# 1. Set LLM_PROVIDER=gemini (the DeepSeek key may remain for rollback).
# 2. Set GEMINI_API_KEY and choose GEMINI_MODEL above.
# 3. `docker compose up -d --force-recreate` (no rebuild needed).
# 4. Re-run the golden + held-out + reasoning gates LOCALLY first; only deploy
#    if they hold. If anything regresses, restore DeepSeek and document.
